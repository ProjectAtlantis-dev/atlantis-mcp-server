# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# Node.js
node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log
.npm
.yarn-integrity
.env*

# Editor directories and files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
*.pid

*.OLD
# Dynamic functions are user/scaffolded code by default. The platform Home app
# is tracked; Demo is scaffolded on first run from python-server/state.py.
python-server/dynamic_functions/*
!python-server/dynamic_functions/Home/
!python-server/dynamic_functions/Home/**
python-server/dynamic_functions/Home/__pycache__/
python-server/dynamic_functions/Home/*.py[cod]
!python-server/dynamic_functions/Chat/
!python-server/dynamic_functions/Chat/**
python-server/dynamic_functions/Chat/__pycache__/
python-server/dynamic_functions/Chat/**/__pycache__/
python-server/dynamic_functions/Chat/**/*.py[cod]
python-server/dynamic_functions/Chat/api_payload.json
python-server/dynamic_functions/Chat/**/*_thumb.jpg
# Chat/Game holds static content (bots, locations, scenes) and is tracked.
# Chat/Data holds live per-game state and is not.
python-server/dynamic_functions/Chat/Data/

# Scratch folders are personal notepads, never shipped. Must come after the
# un-ignore rules above - last matching rule wins.
scratch/

python-server/dynamic_functions copy/*
python-server/dynamic_functions.TEST/

python-server/dynamic_servers/*
!python-server/dynamic_servers/weather.json
python-server/runServer?*
python-server/*.bat
python-server/server_uuid

log/

*.db
python-server/**/*.json
python-server/**/*.log
# Chat/Game content is config-as-JSON (bot/location config.json, Scenes/*.json).
# Must come after the blanket json rule above - last matching rule wins.
!python-server/dynamic_functions/Chat/Game/**/*.json


python-server/dynamic_functions copy 2/
python-server/dynamic_functions copy/
